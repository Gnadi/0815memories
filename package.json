{
  "name": "kaydo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "vite-react-ssg build && node scripts/seo-build.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-kaydo \"vitest run src/__tests__/ourYearRules.test.js src/__tests__/memoryRules.test.js src/__tests__/collageRules.test.js src/__tests__/blackboxRules.test.js src/__tests__/authRules.test.js src/__tests__/feedbackRules.test.js src/__tests__/familySlugRules.test.js src/__tests__/viewerLoginRules.test.js src/__tests__/timelineRules.test.js src/__tests__/anniversaryQueryRules.test.js src/__tests__/entryConversionRules.test.js src/__tests__/printFileStorageRules.test.js src/__tests__/bestOfRules.test.js src/__tests__/recipeRules.test.js src/__tests__/journalRules.test.js src/__tests__/mediaAssetsRules.test.js src/__tests__/mediaRefsRules.test.js src/__tests__/encryptedFieldsRules.test.js src/__tests__/adventRules.test.js\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore,functions --project demo-kaydo \"node scripts/seed-emulator.mjs && playwright test\"",
    "emulators": "firebase emulators:start --only auth,firestore,functions,storage --project demo-kaydo",
    "seed:emulator": "node scripts/seed-emulator.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extensions": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "astronomy-engine": "^2.1.19",
    "dompurify": "^3.4.11",
    "file-saver": "^2.0.5",
    "firebase": "^12.11.0",
    "firebase-admin": "^14.4.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.1.13",
    "react-router-dom": "^6.30.4",
    "tz-lookup": "^6.1.25",
    "vite-react-ssg": "^0.9.1-beta.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.2.1",
    "bcryptjs": "^3.0.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.35.0",
    "globals": "^17.14.0",
    "jsdom": "^29.0.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.2.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "basic-ftp": "^6.2.3",
    "firebase-tools": {
      "chokidar": "^4.0.3"
    }
  }
}
