{
  "name": "kaydo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "vite-react-ssg build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-kaydo \"vitest run src/__tests__/ourYearRules.test.js src/__tests__/memoryRules.test.js src/__tests__/collageRules.test.js src/__tests__/blackboxRules.test.js src/__tests__/authRules.test.js src/__tests__/feedbackRules.test.js src/__tests__/familySlugRules.test.js src/__tests__/viewerLoginRules.test.js src/__tests__/timelineRules.test.js src/__tests__/anniversaryQueryRules.test.js src/__tests__/entryConversionRules.test.js src/__tests__/printFileStorageRules.test.js\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore,functions --project demo-kaydo \"node scripts/seed-emulator.mjs && playwright test\"",
    "emulators": "firebase emulators:start --only auth,firestore,functions,storage --project demo-kaydo",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "migrate:access": "node scripts/migrate-access-control.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astronomy-engine": "^2.1.19",
    "dompurify": "^3.4.11",
    "file-saver": "^2.0.5",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^6.30.4",
    "tz-lookup": "^6.1.25",
    "vite-react-ssg": "^0.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bcryptjs": "^3.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.31.0",
    "globals": "^17.13.0",
    "jsdom": "^29.0.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.2.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "basic-ftp": "^6.2.3",
    "firebase-tools": {
      "chokidar": "^4.0.3"
    }
  }
}
