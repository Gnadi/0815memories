# === Client-side (included in browser bundle) ===
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Largest single file the app will try to upload, in bytes. Media is stored as
# Cloudinary `raw` resources (ciphertext is not a decodable image or video), and
# raw resources are capped per plan — 10 MB on the free tier, regardless of the
# much higher video cap. Anything above it comes back as a 400. Raise this to
# match your plan's raw limit after upgrading. Default: 10485760 (10 MB).
# VITE_CLOUDINARY_MAX_UPLOAD_BYTES=10485760

# Push notifications — Firebase Cloud Messaging (FCM)
# Get this from: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Generate key pair
VITE_FIREBASE_VAPID_KEY=your_vapid_key

# === Server-side only (set in Vercel dashboard, NOT in .env.local) ===
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Push notifications are sent by Firebase Cloud Functions (functions/index.js),
# which compose the text themselves — nothing about a notification is
# configured here. No server-side credentials either: the functions run inside
# Firebase with automatic admin access.
#
# All functions are v2 and deploy to europe-west3, which requires the Blaze
# plan (gen 1 has required it too since the Artifact Registry migration — the
# note that used to be here claiming otherwise was wrong).

# --- Print ordering (api/print/*) ---
#
# Peecho print network — the merchant key that authorises print orders.
# Deliberately has no VITE_ prefix: anything prefixed VITE_ is inlined into the
# browser bundle, and this key places orders that cost real money. It must only
# ever be read by the serverless functions under api/, never by the client.
# Found in the Peecho dashboard under Settings > API. Test and live
# environments have separate keys.
# PEECHO_MERCHANT_API_KEY=your_peecho_merchant_api_key

# Which Peecho environment to talk to. Anything other than the literal "live"
# means the test environment, whose orders never reach a press. Going live has
# to be a deliberate act rather than the absence of configuration.
# PEECHO_MODE=test

# Which print network to use. Only "peecho" exists today; the adapter boundary
# is there so a second one is a new file rather than a rewrite.
# PRINT_PROVIDER=peecho

# The order endpoints verify the caller's Firebase ID token against Google's
# public keys, and check that the print file they name really sits under that
# family's folder in our own bucket. Both need to know which project we are.
# They fall back to the VITE_ values above, so set these only if you would
# rather the server not read the client's variables.
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app

# Optional and temporary. When set, GET /api/print/selftest also accepts this
# value in an x-print-selftest header instead of an admin login, so the print
# network can be checked with curl before any UI exists. It cannot place an
# order or reveal the merchant key. Remove it once the check has been run.
# PRINT_SELFTEST_SECRET=some_long_random_string
# To deploy: npm install -g firebase-tools && firebase deploy --only functions

# === Local development against the Firebase Emulator Suite (optional) ===
# Set VITE_USE_EMULATOR=true (in .env.local) to route Auth + Firestore to the
# local emulators instead of a real project. The Firebase values above only need
# to be non-empty placeholders in this mode; VITE_FIREBASE_PROJECT_ID must match
# the project id in .firebaserc (demo-kaydo). Used to seed sample data and capture
# the landing-page screenshots. Run order:
#   1) npx firebase-tools emulators:start
#   2) npm run seed:emulator
#   3) VITE_USE_EMULATOR=true npm run dev
# VITE_USE_EMULATOR=true
