# === Client-side (included in browser bundle) ===
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Largest single file the app will try to upload, in bytes. Media is stored as
# Cloudinary `raw` resources (ciphertext is not a decodable image or video), and
# raw resources are capped per plan — 10 MB on the free tier, regardless of the
# much higher video cap. Anything above it comes back as a 400. Raise this to
# match your plan's raw limit after upgrading. Default: 10485760 (10 MB).
# VITE_CLOUDINARY_MAX_UPLOAD_BYTES=10485760

# Push notifications — Firebase Cloud Messaging (FCM)
# Get this from: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Generate key pair
VITE_FIREBASE_VAPID_KEY=your_vapid_key

# === Server-side only (set in Vercel dashboard, NOT in .env.local) ===
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Push notifications are sent via a Firebase Cloud Function (functions/index.js).
# No additional server-side credentials are required here — the Cloud Function
# runs inside Firebase and has automatic admin access.
# Uses Cloud Functions gen 1, which works on the free Firebase Spark plan.
# To deploy: npm install -g firebase-tools && firebase deploy --only functions

# === Local development against the Firebase Emulator Suite (optional) ===
# Set VITE_USE_EMULATOR=true (in .env.local) to route Auth + Firestore to the
# local emulators instead of a real project. The Firebase values above only need
# to be non-empty placeholders in this mode; VITE_FIREBASE_PROJECT_ID must match
# the project id in .firebaserc (demo-kaydo). Used to seed sample data and capture
# the landing-page screenshots. Run order:
#   1) npx firebase-tools emulators:start
#   2) npm run seed:emulator
#   3) VITE_USE_EMULATOR=true npm run dev
# VITE_USE_EMULATOR=true
