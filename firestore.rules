rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Who is asking ───────────────────────────────────────────────────
    //
    // Both roles are stated by the ID token, not by the client: `viewer` is
    // minted by the viewerLogin Cloud Function after it checks the shared
    // password, `admin` by the syncAdminClaims trigger whenever `adminUids`
    // changes. Neither can be produced by editing localStorage, which is what
    // the old viewer session amounted to.

    function tokenFamily() {
      return request.auth != null ? request.auth.token.get('familyId', '') : '';
    }

    function tokenRole() {
      return request.auth != null ? request.auth.token.get('role', '') : '';
    }

    // Reads the family document, for an admin who is in `adminUids` but whose
    // claim has not landed yet.
    //
    // This is not migration debt to be cleaned up later. The claim is written by
    // the syncAdminClaims trigger, so it always arrives *after* the write that
    // makes someone an admin — and an invited admin takes their encryption key
    // from this very document. Without this branch they would hold no key until
    // the claim arrived and something re-subscribed, which nothing does.
    //
    // It is free in the common case: isFamilyAdmin checks the claim first and
    // `||` short-circuits, so this runs only for a caller who has none.
    function isAdminByDocument(familyId) {
      let fam = get(/databases/$(database)/documents/families/$(familyId)).data;
      return request.auth != null
        && (request.auth.uid in fam.get('adminUids', [fam.adminUid])
            || request.auth.uid == fam.adminUid);
    }

    function isFamilyAdmin(familyId) {
      return request.auth != null
        && ((tokenFamily() == familyId && tokenRole() == 'admin')
            || isAdminByDocument(familyId));
    }

    // A viewer reads, and only within their own family. Nothing grants a viewer
    // write access anywhere — every write rule below asks for isFamilyAdmin.
    function isFamilyViewer(familyId) {
      return tokenFamily() == familyId && tokenRole() == 'viewer';
    }

    // Viewer first, deliberately: the check is pure token arithmetic, so a
    // viewer never falls through to the get() inside isAdminByDocument. On a
    // feed listing dozens of documents that is the difference between no
    // document reads and one per evaluation.
    function isFamilyMember(familyId) {
      return isFamilyViewer(familyId) || isFamilyAdmin(familyId);
    }

    // Has this capsule's unlock date arrived?
    //
    // Read from the capsule's own metadata document rather than duplicated onto
    // the content document, so a legacy check-in that moves the date cannot
    // leave the two disagreeing about when the letter opens. Costs one extra
    // document read, and only on the path where someone opens a capsule.
    //
    // A capsule with no metadata document, or no date, never opens. Both are the
    // safe direction: `get` returns null for a missing document and `.data` on
    // null fails the rule, which denies.
    function capsuleIsOpen(boxId) {
      let meta = get(/databases/$(database)/documents/blackbox/$(boxId));
      return meta != null
        && meta.data.get('unlockDate', null) != null
        && request.time >= meta.data.unlockDate;
    }

    // An unlock date may be pushed further out — never pulled closer, and never
    // cleared once it is set.
    //
    // Clearing used to be allowed, on the grounds that a capsule with no date
    // never opens. But "no date" was also the state from which any date was
    // accepted, so clearing a 2041 date and then writing yesterday's opened the
    // capsule in two writes. A capsule that has no date yet may only be given
    // one in the future, which is what the legacy check-in does.
    function unlockDateOnlyMovesForward() {
      let current = resource.data.get('unlockDate', null);
      let next = request.resource.data.get('unlockDate', null);
      return (current == null && (next == null || next > request.time))
        || (current != null && next != null && next >= current);
    }

    // An update may never move a document to another family. Without this, an
    // admin of any family — and anyone can make one by signing up — could
    // create a document in their own family and then re-home it into a
    // stranger's feed, where the family filter the client sends would pick it
    // up like any other.
    function familyUnchanged() {
      return request.resource.data.familyId == resource.data.familyId;
    }

    // Shape limits for the login-page customization fields. The family doc is
    // world-readable and served to every login-page visitor, so cap the sizes
    // (limits mirror src/utils/loginPageSanitizer.js) and constrain the mode
    // enum. `request.resource.data` is the post-merge document, so these hold
    // for setDoc(..., { merge: true }) writes too.
    function loginCustomOk() {
      let d = request.resource.data;
      return (!('loginCustomHtml' in d) || (d.loginCustomHtml is string && d.loginCustomHtml.size() <= 65536))
        && (!('loginCustomCss' in d) || (d.loginCustomCss is string && d.loginCustomCss.size() <= 32768))
        && (!('loginPageMode' in d) || d.loginPageMode in ['classic', 'theme', 'custom'])
        && (!('loginTheme' in d) || (d.loginTheme is map
            && (!('welcomeTitle' in d.loginTheme) || (d.loginTheme.welcomeTitle is string && d.loginTheme.welcomeTitle.size() <= 200))
            && (!('welcomeMessage' in d.loginTheme) || (d.loginTheme.welcomeMessage is string && d.loginTheme.welcomeMessage.size() <= 200))))
        && (!('loginCard' in d) || (d.loginCard is map
            && (!('behavior' in d.loginCard) || d.loginCard.behavior in ['minimized', 'card'])
            && (!('style' in d.loginCard) || d.loginCard.style in ['light', 'dark', 'glass'])));
    }

    // Families — readable by the family only. The password check that used to
    // need a public read now happens in the viewerLogin Cloud Function.
    // Updates fall into one of four explicit paths; everything else is denied.
    // Admin-list mutations only happen via these gated paths — there is no
    // server endpoint with elevated privileges in this app.
    match /families/{familyId} {
      // Was `if true`, which handed the encryption key and the password hash to
      // anyone who knew the family id — and the login page handed the id out.
      // What the login page actually needs now lives in familyPublic below.
      allow read: if isFamilyMember(familyId);
      allow create: if request.auth != null
                    && tokenRole() != 'viewer'
                    && request.resource.data.adminUid == request.auth.uid
                    && (!('adminUids' in request.resource.data)
                        || request.resource.data.adminUids == [request.auth.uid])
                    && loginCustomOk();
      allow update: if request.auth != null
                    && request.resource.data.adminUid == resource.data.adminUid
                    && loginCustomOk()
                    && (
                      // Path A: existing admin edits regular fields; adminUids unchanged.
                      (
                        request.auth.uid in resource.data.get('adminUids', [resource.data.adminUid])
                        && request.resource.data.get('adminUids', null) == resource.data.get('adminUids', null)
                      )
                      // Path B: owner one-shot lazy migration of `adminUids`.
                      || (
                        request.auth.uid == resource.data.adminUid
                        && !('adminUids' in resource.data)
                        && request.resource.data.adminUids == [resource.data.adminUid]
                      )
                      // Path C: invite redemption — caller adds exactly themselves,
                      // and changes nothing else.
                      //
                      // The proof is an `admins/{caller}` document created in this
                      // same batch; its rule only allows that while consuming a
                      // fresh invite. It has to be new: a document that merely
                      // exists proves only that an invite was redeemed once, and
                      // accepting that let a removed admin whose old document was
                      // recreated from the spent invite walk straight back in.
                      || (
                        !(request.auth.uid in resource.data.get('adminUids', [resource.data.adminUid]))
                        && request.auth.uid in request.resource.data.adminUids
                        && request.resource.data.adminUids.size() == resource.data.get('adminUids', [resource.data.adminUid]).size() + 1
                        && request.resource.data.adminUids.hasAll(resource.data.get('adminUids', [resource.data.adminUid]))
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminUids'])
                        && !exists(/databases/$(database)/documents/families/$(familyId)/admins/$(request.auth.uid))
                        && existsAfter(/databases/$(database)/documents/families/$(familyId)/admins/$(request.auth.uid))
                      )
                      // Path D: existing admin removes another admin (or self, leaving owner).
                      // The owner is always retained because `adminUid` is unchanged AND
                      // the resulting array must still contain `adminUid`.
                      || (
                        request.auth.uid in resource.data.get('adminUids', [resource.data.adminUid])
                        && request.resource.data.adminUids.size() == resource.data.get('adminUids', [resource.data.adminUid]).size() - 1
                        && resource.data.get('adminUids', [resource.data.adminUid]).hasAll(request.resource.data.adminUids)
                        && resource.data.adminUid in request.resource.data.adminUids
                      )
                    );
      allow delete: if false;
    }

    // Secrets — the shared-password hash. No client reads or writes this, ever.
    // The Cloud Functions that do go through the Admin SDK, which bypasses rules.
    match /families/{familyId}/secrets/{docId} {
      allow read, write: if false;
    }

    // The public face of a family: what the login page needs before anyone has
    // authenticated, and nothing else. Written only by the mirrorFamilyPublic
    // trigger from a fixed allowlist, so a field added to `families` later
    // cannot surface here by accident.
    match /familyPublic/{familyId} {
      allow read: if true;
      allow write: if false;
    }

    // Who owns which family address (`<slug>.kaydo.app`). Kept by the same
    // trigger through the Admin SDK — see functions/slugs.js. Clients only ever
    // see the result, as familyPublic.familySlug.
    match /familySlugs/{slug} {
      allow read, write: if false;
    }

    // Admins subcollection — display metadata for the Manage Admins UI AND
    // the proof of redemption for the invite flow (via `viaInvite`).
    //
    // Redemption is one batch of three writes, and each rule insists on the
    // other two: the invite is consumed, this document is created, and the
    // caller joins `adminUids` (Path C above). It used to be three separate
    // writes, and the invite stayed `used` by the redeemer until it expired —
    // so an admin removed within a week of joining could recreate this document
    // from their spent invite and re-add themselves.
    match /families/{familyId}/admins/{uid} {
      allow read: if isFamilyAdmin(familyId);
      // Only while consuming an invite that was still unused before this batch
      // and is used by this caller after it, and only while joining adminUids.
      allow create: if request.auth != null
                    && tokenRole() != 'viewer'
                    && request.auth.uid == uid
                    && request.resource.data.viaInvite is string
                    && get(/databases/$(database)/documents/families/$(familyId)/invites/$(request.resource.data.viaInvite)).data.used == false
                    && get(/databases/$(database)/documents/families/$(familyId)/invites/$(request.resource.data.viaInvite)).data.expiresAt > request.time
                    && getAfter(/databases/$(database)/documents/families/$(familyId)/invites/$(request.resource.data.viaInvite)).data.used == true
                    && getAfter(/databases/$(database)/documents/families/$(familyId)/invites/$(request.resource.data.viaInvite)).data.redeemedBy == request.auth.uid
                    && request.auth.uid in getAfter(/databases/$(database)/documents/families/$(familyId)).data.get('adminUids', []);
      allow update: if false;
      // Admin can revoke (used when removing an admin from the family).
      allow delete: if isFamilyAdmin(familyId);
    }

    // Invites subcollection — one-time tokens that grant family-admin status
    // when redeemed. Possessing the slotId (doc ID) is the credential.
    //
    // Listing and minting ask the family document, not the token claim. A
    // removed admin keeps their claim in the ID token they hold for up to an
    // hour — revoking refresh tokens does not reach it — and either of these
    // would turn that hour into a way back in.
    match /families/{familyId}/invites/{slotId} {
      // Holding the link is the credential, so a direct read by slot id stays
      // open. Listing does not: the collection is keyed by the very token that
      // grants admin status, so an enumerable list is a list of usable
      // credentials. Only an admin of the family may enumerate them.
      allow get: if true;
      allow list: if isAdminByDocument(familyId);
      // Only existing admins may mint invites for their family.
      allow create: if request.auth != null
                    && isAdminByDocument(familyId)
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.used == false
                    && request.resource.data.redeemedBy == null
                    && request.resource.data.expiresAt is timestamp;
      // The redeemer marks the invite as used, in the batch that also creates
      // their admins/{uid} document. Strict false → true transition; immutable
      // createdBy / expiresAt.
      allow update: if request.auth != null
                    && tokenRole() != 'viewer'
                    && resource.data.used == false
                    && resource.data.expiresAt > request.time
                    && request.resource.data.used == true
                    && request.resource.data.redeemedBy == request.auth.uid
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.expiresAt == resource.data.expiresAt
                    && existsAfter(/databases/$(database)/documents/families/$(familyId)/admins/$(request.auth.uid));
      // Admins can revoke pending invites.
      allow delete: if isFamilyAdmin(familyId);
    }

    // Memories — readable by the family (admins and viewers alike),
    // writable only by an admin of the memory's family.
    //
    // `contentRich` is the rich description document. Memory docs are
    // world-readable, so confidentiality rests entirely on the client
    // encrypting before it writes — there is no privileged server path that
    // could re-encrypt after the fact. This is the backstop for the one way
    // that can silently go wrong: encryptFields() skips any value that is not
    // a string, so a document object would land here readable. Requiring a
    // string rejects exactly that. The leading-character check catches the
    // next case up — stringified but unencrypted JSON — because encryptText()
    // emits base64, which can never begin with '{' or '['.
    //
    // Deliberately scoped to this one field: the older text fields have
    // pre-encryption data in the wild that a type check would now block.
    function memoryContentOk() {
      let d = request.resource.data;
      return !('contentRich' in d)
        || (d.contentRich is string
            && d.contentRich.size() > 0
            && d.contentRich.size() <= 700000
            && d.contentRich[0:1] != '{'
            && d.contentRich[0:1] != '[');
    }

    match /memories/{memoryId} {
      // Was `if true`. The documents carry the Cloudinary URLs in clear text,
      // so a public list was a public index of every family's media.
      allow read: if isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null
                    && request.resource.data.familyId != null
                    && exists(/databases/$(database)/documents/families/$(request.resource.data.familyId))
                    && isFamilyAdmin(request.resource.data.familyId)
                    && memoryContentOk();
      allow update: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId)
                    && familyUnchanged()
                    && memoryContentOk();
      allow delete: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId);
    }

    // Moments — same rules as memories
    match /moments/{momentId} {
      // Same as memories: listed by familyId, so the filter the client already
      // sends is what makes the query pass.
      allow read: if isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null
                    && request.resource.data.familyId != null
                    && exists(/databases/$(database)/documents/families/$(request.resource.data.familyId))
                    && isFamilyAdmin(request.resource.data.familyId);
      allow update: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId)
                    && familyUnchanged();
      allow delete: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId);
    }

    // Albums — same rules as memories
    match /albums/{albumId} {
      // Not referenced anywhere in the client. Gated rather than removed —
      // deleting a collection that might still hold data is a separate call.
      allow read: if isFamilyMember(resource.data.familyId);
      allow create: if request.auth != null
                    && request.resource.data.familyId != null
                    && exists(/databases/$(database)/documents/families/$(request.resource.data.familyId))
                    && isFamilyAdmin(request.resource.data.familyId);
      allow update: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId)
                    && familyUnchanged();
      allow delete: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId);
    }

    // Children — admin only (not visible to viewers)
    match /children/{childId} {
      allow read: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId);
      allow create: if request.auth != null
                    && request.resource.data.familyId != null
                    && exists(/databases/$(database)/documents/families/$(request.resource.data.familyId))
                    && isFamilyAdmin(request.resource.data.familyId);
      allow update: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId)
                    && familyUnchanged();
      allow delete: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId);
    }

    // Journals — admin only (private letters to children)
    match /journals/{journalId} {
      allow read: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId);
      allow create: if request.auth != null
                    && request.resource.data.familyId != null
                    && exists(/databases/$(database)/documents/families/$(request.resource.data.familyId))
                    && isFamilyAdmin(request.resource.data.familyId);
      allow update: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId)
                    && familyUnchanged();
      allow delete: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId);
    }

    // Black Box — a capsule is two documents.
    //
    // `blackbox/{boxId}` is the metadata: title, trigger, unlock date. Admins
    // read it whenever, because the sealed card is built from it — that is what
    // shows "sealed until March 2041" without anyone reading the letter.
    //
    // `blackboxContent/{boxId}` is the letter itself, and Firestore hands it to
    // nobody before the date. The split is not cosmetic: `blackbox` is queried
    // by familyId, and on a list operation one denied document fails the whole
    // listener, so a time condition on the metadata would blank the page for any
    // family holding one sealed capsule. The same shape as ourYearLetters, which
    // gets away with a single document only because it is read by ID.
    match /blackbox/{boxId} {
      allow read: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId);
      // Not over a letter that already exists. The metadata is what
      // capsuleIsOpen() reads, so deleting it and recreating it under the same
      // id with yesterday's date would otherwise open a sealed letter. addBox
      // writes both halves in one batch, and `exists()` sees the state before
      // the batch, so a genuinely new capsule passes.
      allow create: if request.auth != null
                    && request.resource.data.familyId != null
                    && exists(/databases/$(database)/documents/families/$(request.resource.data.familyId))
                    && isFamilyAdmin(request.resource.data.familyId)
                    && !exists(/databases/$(database)/documents/blackboxContent/$(boxId));
      // The unlock date may only ever move further away. That is what makes the
      // legacy check-in safe to expose — a capsule's deadline can be pushed
      // back indefinitely by someone who is still here, and nobody can pull a
      // date-triggered capsule forward to read it early. The cost is that a
      // mistyped date cannot be corrected; the create page confirms it instead.
      allow update: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId)
                    && request.resource.data.familyId == resource.data.familyId
                    && unlockDateOnlyMovesForward();
      allow delete: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId);
    }

    match /blackboxContent/{boxId} {
      // `resource == null` is allowed so a capsule whose content has not been
      // split out yet reads as absent rather than denied — that is how the card
      // knows to fall back to the pre-split inline fields.
      allow read: if request.auth != null
                    && (resource == null
                        || (resource.data.familyId != null
                            && isFamilyAdmin(resource.data.familyId)
                            && capsuleIsOpen(boxId)));
      // Only for a capsule of the same family. The metadata is written in the
      // same batch (addBox) or already exists (the migration), so getAfter()
      // finds it either way. Without this, another family's admin could plant
      // a letter under the id of a capsule that predates the split, and the
      // owners would be denied their own capsule's content.
      allow create: if request.auth != null
                    && request.resource.data.familyId != null
                    && exists(/databases/$(database)/documents/families/$(request.resource.data.familyId))
                    && isFamilyAdmin(request.resource.data.familyId)
                    && getAfter(/databases/$(database)/documents/blackbox/$(boxId)).data.familyId
                         == request.resource.data.familyId;
      // Editing the letter is only possible once it has opened. Deleting is
      // allowed while sealed: discarding a capsule you no longer want must not
      // require waiting years for it, and the metadata delete is what the UI
      // actually offers.
      allow update: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId)
                    && familyUnchanged()
                    && capsuleIsOpen(boxId);
      allow delete: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId);
    }

    // Scrapbooks — admin only (digital scrapbook pages)
    match /scrapbooks/{scrapbookId} {
      allow read: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId);
      allow create: if request.auth != null
                    && request.resource.data.familyId != null
                    && exists(/databases/$(database)/documents/families/$(request.resource.data.familyId))
                    && isFamilyAdmin(request.resource.data.familyId);
      allow update: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId)
                    && familyUnchanged();
      allow delete: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId);
    }

    // Collages — admin only (template-based photo collages)
    match /collages/{collageId} {
      allow read: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId);
      allow create: if request.auth != null
                    && request.resource.data.familyId != null
                    && exists(/databases/$(database)/documents/families/$(request.resource.data.familyId))
                    && isFamilyAdmin(request.resource.data.familyId);
      allow update: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId)
                    && familyUnchanged();
      allow delete: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId);
    }

    // Highlight videos — admin only. The document is the recipe (shot list,
    // durations, title card); the rendered video never leaves the browser
    // unless it is posted to the feed as an ordinary memory.
    match /highlights/{highlightId} {
      allow read: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId);
      allow create: if request.auth != null
                    && request.resource.data.familyId != null
                    && exists(/databases/$(database)/documents/families/$(request.resource.data.familyId))
                    && isFamilyAdmin(request.resource.data.familyId);
      allow update: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId)
                    && familyUnchanged();
      allow delete: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId);
    }

    // Recipes — admin only (version-controlled family recipes)
    match /recipes/{recipeId} {
      allow read: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId);
      allow create: if request.auth != null
                    && request.resource.data.familyId != null
                    && exists(/databases/$(database)/documents/families/$(request.resource.data.familyId))
                    && isFamilyAdmin(request.resource.data.familyId);
      allow update: if request.auth != null
                    && resource.data.familyId != null
                    && request.resource.data.familyId == resource.data.familyId
                    && isFamilyAdmin(resource.data.familyId);
      allow delete: if request.auth != null
                    && resource.data.familyId != null
                    && isFamilyAdmin(resource.data.familyId);
    }

    // -----------------------------------------------------------------------
    // "Our Year" — the couple's recurring review ritual.
    //
    // Stricter than every other collection in this file: family-admin status is
    // not enough. Each document carries `participantUids` (exactly the two
    // partners), and only those two can read it — other admins of the same
    // family see nothing. Two further guarantees are enforced here rather than
    // in the UI, because the whole point of the ritual is that they hold:
    //   1. neither partner can read the other's answers before both are in
    //      (ourYearEntries);
    //   2. a sealed letter cannot be read or altered before its open date
    //      (ourYearLetters) — request.time is the server's clock.
    // -----------------------------------------------------------------------

    // The ritual itself: who, which occasion, which rhythm.
    match /ourYearRituals/{ritualId} {
      allow read: if request.auth != null
                    && request.auth.uid in resource.data.get('participantUids', []);
      allow create: if request.auth != null
                    && request.resource.data.familyId != null
                    && exists(/databases/$(database)/documents/families/$(request.resource.data.familyId))
                    && isFamilyAdmin(request.resource.data.familyId)
                    && request.resource.data.participantUids is list
                    && request.resource.data.participantUids.size() == 2
                    && request.auth.uid in request.resource.data.participantUids;
      // Participants may edit the ritual, but never re-home it or hand it to
      // someone else.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.get('participantUids', [])
                    && request.resource.data.familyId == resource.data.familyId
                    && request.resource.data.participantUids == resource.data.participantUids;
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.get('participantUids', []);
    }

    // One chapter = one review of a self-chosen period. Carries only metadata
    // about the answers (who handed in, whether they are revealed) — never the
    // answers themselves.
    match /ourYearChapters/{chapterId} {
      allow read: if request.auth != null
                    && (resource == null
                        || request.auth.uid in resource.data.get('participantUids', []));
      allow create: if request.auth != null
                    && request.resource.data.familyId != null
                    && exists(/databases/$(database)/documents/families/$(request.resource.data.familyId))
                    && isFamilyAdmin(request.resource.data.familyId)
                    && request.resource.data.participantUids is list
                    && request.auth.uid in request.resource.data.participantUids;
      // A closed chapter is a time capsule: once it is closed, only the letter
      // bookkeeping may still change (opening a letter that was written back
      // then). Everything else is frozen for good.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.get('participantUids', [])
                    && request.resource.data.familyId == resource.data.familyId
                    && request.resource.data.participantUids == resource.data.participantUids
                    && (
                      resource.data.get('status', 'open') != 'closed'
                      || request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['letterStatus', 'letterOpenedAt', 'updatedAt'])
                    );
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.get('participantUids', []);
    }

    // Has the caller handed in their own answers to the same part of the same
    // chapter? Entry ids are `<chapterId>_<kind>_<uid>` (entryId() in
    // src/hooks/useOurYear.js), so the caller's own document is addressable
    // from the fields of their partner's. A missing document fails the rule.
    function callerHandedIn(entry) {
      return get(/databases/$(database)/documents/ourYearEntries/$(entry.chapterId + '_' + entry.kind + '_' + request.auth.uid))
        .data.get('submitted', false) == true;
    }

    // One partner's answers to one part of one chapter. The read rule is what
    // makes "write independently, then look together" real: until `revealed`
    // is set, only the author can read their own document — which is why
    // setting `revealed` is guarded as closely as reading would be.
    match /ourYearEntries/{entryId} {
      // `resource == null` covers a document that does not exist yet: a client
      // subscribes to its own entry before writing it, and denying that read
      // would kill the listener instead of reporting an empty answer sheet.
      // Nothing leaks — there is nothing there.
      allow read: if request.auth != null
                    && (resource == null
                        || (request.auth.uid in resource.data.get('participantUids', [])
                            && (resource.data.get('authorUid', '') == request.auth.uid
                                || resource.data.get('revealed', false) == true)));
      allow create: if request.auth != null
                    && request.resource.data.familyId != null
                    && exists(/databases/$(database)/documents/families/$(request.resource.data.familyId))
                    && isFamilyAdmin(request.resource.data.familyId)
                    && request.auth.uid in request.resource.data.participantUids
                    && request.resource.data.get('authorUid', '') == request.auth.uid;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.get('participantUids', [])
                    && (
                      // Your own answers, yours to edit until you hand them in.
                      // After that they are fixed, or the look at your
                      // partner's answers would come with a chance to rewrite
                      // your own. What the entry belongs to, and whether it is
                      // revealed, are not the author's to change either.
                      (resource.data.get('authorUid', '') == request.auth.uid
                        && resource.data.get('submitted', false) != true
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['familyId', 'participantUids', 'authorUid', 'chapterId', 'kind', 'revealed']))
                      // The reveal: whoever finishes second flips this flag on
                      // BOTH documents. `revealed` is the only key they may
                      // touch on their partner's — so the write must not carry
                      // an updatedAt alongside it. Both answers have to be
                      // handed in first: this flag is what the read rule
                      // checks, so a partner who could set it early could read
                      // early.
                      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revealed'])
                          && request.resource.data.revealed == true
                          && resource.data.get('submitted', false) == true
                          && callerHandedIn(resource.data))
                    );
      // Either partner may delete, so discarding a chapter cleans up both
      // sides. Destroying an answer is fine; reading it early is not, and that
      // is what the read rule above guards.
      //
      // A handed-in answer, though, only once its chapter is gone: deleting and
      // recreating it would otherwise undo the hand-in after the partner's
      // answers were already visible. deleteChapter removes the chapter first
      // for exactly this reason.
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.get('participantUids', [])
                    && (resource.data.get('submitted', false) != true
                        || !exists(/databases/$(database)/documents/ourYearChapters/$(resource.data.chapterId)));
    }

    // The letter to the couple's future self. While it is sealed and the open
    // date has not arrived, Firestore hands the document to nobody — not the
    // partners, not through the console. The chapter document carries the
    // status and the open date so the UI can show the wait without reading it.
    match /ourYearLetters/{chapterId} {
      allow read: if request.auth != null
                    && (resource == null
                        || (request.auth.uid in resource.data.get('participantUids', [])
                            && (resource.data.get('sealedAt', null) == null
                                || request.time >= resource.data.openAt)));
      allow create: if request.auth != null
                    && request.resource.data.familyId != null
                    && exists(/databases/$(database)/documents/families/$(request.resource.data.familyId))
                    && isFamilyAdmin(request.resource.data.familyId)
                    && request.auth.uid in request.resource.data.participantUids
                    && request.resource.data.get('sealedAt', null) == null;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.get('participantUids', [])
                    && request.resource.data.familyId == resource.data.familyId
                    && request.resource.data.participantUids == resource.data.participantUids
                    && (resource.data.get('sealedAt', null) == null
                        || request.time >= resource.data.openAt);
      // Deleting is allowed (a chapter can be discarded while it is open);
      // reading early is not, which is the property that matters.
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.get('participantUids', []);
    }

    // FCM push tokens — one document per device, its id the SHA-256 of the token.
    //
    // The id is derived rather than looked up because of the read rule below:
    // the client used to query this collection for an existing token before
    // writing, the query was denied, and nothing was ever stored. Tokens are
    // read server-side only, through the Admin SDK, which bypasses these rules.
    //
    // Writes now require a session. That was not possible while viewers had no
    // identity — it is since viewerLogin started minting them, so this is no
    // longer an anonymously writable collection.
    match /fcmTokens/{tokenId} {
      allow create, update: if request.resource.data.familyId is string
                            && isFamilyMember(request.resource.data.familyId)
                            && request.resource.data.token is string
                            && request.resource.data.token.size() > 0
                            && request.resource.data.token.size() < 4096;
      // A device unsubscribing on logout. Scoped to the family, so no one can
      // silence another family's devices.
      allow delete: if isFamilyMember(resource.data.familyId);
      allow read: if false;
    }

    // Login throttle counters, written by the viewerLogin function through the
    // Admin SDK. No client has any business reading how close someone is to
    // being blocked.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // Feedback about the app itself — write-only, for every family member.
    //
    // Three things make this collection different from the rest of the app:
    //
    //   1. A *viewer* may write here. Everywhere else a viewer only reads, but
    //      most of the people living in a family's space are viewers, and they
    //      are the ones with the most to say about how the app behaves.
    //   2. Nobody may read it back. Feedback is addressed to whoever runs
    //      Kaydo, and a client-readable collection would hand every family's
    //      notes to every other family. It is read server-side (Admin SDK and
    //      the console, both of which bypass these rules).
    //   3. It is not encrypted, deliberately — see src/hooks/useFeedback.js.
    //      Which is exactly why the shape is pinned down here: an unencrypted
    //      collection any signed-in client can append to is worth being strict
    //      about. Limits mirror src/constants/feedback.js.
    //
    // Immutable once written: no update and no delete, so a document cannot be
    // rewritten after the fact by the account that sent it.
    function feedbackShapeOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['familyId', 'uid', 'role', 'message', 'category',
                               'rating', 'contact', 'path', 'language',
                               'userAgent', 'status', 'createdAt'])
        && d.message is string && d.message.size() > 0 && d.message.size() <= 2000
        && d.category in ['bug', 'idea', 'praise', 'other']
        && (d.rating == null || (d.rating is int && d.rating >= 1 && d.rating <= 5))
        && d.contact is string && d.contact.size() <= 200
        && d.path is string && d.path.size() <= 200
        && d.language is string && d.language.size() <= 16
        && d.userAgent is string && d.userAgent.size() <= 300
        // Triage state belongs to whoever reads the collection, so the client
        // may only ever open one at the start of that process.
        && d.status == 'new'
        && d.createdAt == request.time
        && d.uid == request.auth.uid
        && d.role in ['admin', 'viewer']
        // A viewer cannot sign their feedback as an admin. The reverse is not
        // checked: an admin whose claim has not landed yet reads as neither.
        && (tokenRole() != 'viewer' || d.role == 'viewer');
    }

    match /feedback/{feedbackId} {
      allow create: if request.auth != null
                    && request.resource.data.familyId is string
                    && isFamilyMember(request.resource.data.familyId)
                    && feedbackShapeOk();
      allow read, update, delete: if false;
    }

    // The `notificationsQueue` collection that used to live here is gone. The
    // client no longer composes push notifications: it wrote the plaintext
    // title of an otherwise encrypted memory into a Firestore document, and it
    // let any admin broadcast arbitrary text to every device in the family.
    // notifyOnMemory / notifyOnMoment now trigger on the content itself and
    // write the text server-side.
    match /notificationsQueue/{docId} {
      allow read, write: if false;
    }
  }
}
